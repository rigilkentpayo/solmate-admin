{
  "name": "solmate-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .next out",
    "dev": "next dev",
    "dev:ghpages": "cross-env DEPLOY_TARGET=ghpages next dev",
    "build": "next build",
    "build:domain": "cross-env DEPLOY_TARGET=domain next build",
    "build:ghpages": "cross-env DEPLOY_TARGET=ghpages next build",
    "serve:out": "npx serve out -p 3001",
    "deploy:domain": "npm run clean && cross-env DEPLOY_TARGET=domain next build && node -e \"require('fs').writeFileSync('out/CNAME','solmateadmin.live')\" && gh-pages -d out -b gh-pages -f -m \"domain deploy\"",
    "deploy:ghpages": "npm run clean && cross-env DEPLOY_TARGET=ghpages next build && node -e \"require('fs').writeFileSync('out/.nojekyll','')\" && gh-pages -d out -b gh-pages -f -m \"ghpages deploy\""
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.3.0",
    "framer-motion": "^12.23.22",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.544.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "gh-pages": "^6.2.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
